{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "paths": {
      "@duopoker/shared-types/*": ["packages/shared-types/dist/*"],
      "@duopoker/game-engine/*": ["packages/game-engine/dist/*"],
      "@duopoker/db-schema": ["packages/db-schema/src/generated/prisma-client/index"],
      "@duopoker/server-shared/lib/*": ["packages/server-shared/src/lib/*"],
      "@duopoker/server-shared/services/*": ["packages/server-shared/src/services/*"]
    }
  },
  "include": ["src"]
}
