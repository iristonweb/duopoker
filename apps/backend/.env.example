# =============================================================================
# Backend Express — локально или Render (НЕ Vercel serverless)
# =============================================================================
# На Vercel эти переменные не нужны — там работает packages/api.
# Скопируй в apps/backend/.env и заполни значения.
# =============================================================================

PORT=4000

# Docker Postgres (порт 5434) или Neon connection string
DATABASE_URL=postgresql://duopoker:duopoker@127.0.0.1:5434/duopoker

# Опционально — без Redis auth идёт через Postgres device_sessions
# REDIS_URL=redis://127.0.0.1:6380
# MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=duopoker

# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-refresh

PUBLIC_WEB_URL=http://localhost:5180
CORS_ORIGIN=http://localhost:5180,http://127.0.0.1:5180,https://duopoker.ru,https://www.duopoker.ru,https://duopoker.vercel.app

ALLOW_SOLO_QUEUE=true
MOCK_CHECKOUT=true

# LiveKit — cloud.livekit.io → Settings → Keys
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud

# YooKassa / YooMoney (club organizer billing)
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=

# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Run: pnpm stripe:setup --write-env  (after setting STRIPE_SECRET_KEY)
# STRIPE_PRICE_BRONZE=price_...
# STRIPE_PRICE_SILVER=price_...
# STRIPE_PRICE_GOLD=price_...
# STRIPE_PRICE_PLATINUM=price_...
# STRIPE_PRICE_DIAMOND=price_...
# STRIPE_PRICE_BLACK=price_...

# Email verification (optional)
# REQUIRE_EMAIL_VERIFICATION=true
# RESEND_API_KEY=
# EMAIL_FROM=DuoPoker <noreply@yourdomain.com>

# OAuth (optional)
# OAUTH_GOOGLE_ENABLED=true
# GOOGLE_CLIENT_ID=
