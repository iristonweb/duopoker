PORT=4000
DATABASE_URL=postgresql://duopoker:duopoker@localhost:5433/duopoker
REDIS_URL=redis://localhost:6380
MONGO_URL=mongodb://localhost:27017
MONGO_DB=duopoker

# Generate strong secrets (do not reuse the example values):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-refresh

# Frontend origin(s) for CORS — comma-separated
PUBLIC_WEB_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Matchmaking: pair one human with a bot so you can play without a second client (local dev).
ALLOW_SOLO_QUEUE=true

# Checkout: redirect to /lobby without calling Stripe (no STRIPE_SECRET_KEY needed).
# MOCK_CHECKOUT=true

# Stripe (optional; use https://dashboard.stripe.com/test API keys for development)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_SILVER=
# STRIPE_PRICE_GOLD=
# STRIPE_PRICE_PLATINUM=
# STRIPE_PRICE_ROYAL=

# OAuth (optional)
# OAUTH_GOOGLE_ENABLED=true
# GOOGLE_CLIENT_ID=
