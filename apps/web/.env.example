# =============================================================================
# Frontend — локальная разработка (apps/web)
# =============================================================================

# ── Режим A: Vercel-style API (polling, без Socket.IO) ─────────────────────
# Запусти: pnpm --filter @duopoker/api dev  (:3001)
# Не задавай VITE_API_URL — Vite проксирует /api → localhost:3001
# VITE_API_PROXY=http://localhost:3001

# ── Режим B: полный backend (Socket.IO + LiveKit) ─────────────────────────
# Запусти: pnpm --filter @duopoker/backend dev  (:4000)
VITE_API_URL=http://localhost:4000
# VITE_API_PROXY=http://localhost:4000  # опционально, это значение по умолчанию

# ── Vercel production ───────────────────────────────────────────────────────
# VITE_API_URL не задавай — сайт вызывает /api на том же домене.
# Секреты (DATABASE_URL, JWT, LIVEKIT) — только в Vercel Dashboard, см. .env.vercel.example

# ── Опционально ─────────────────────────────────────────────────────────────
# VITE_SENTRY_DSN=
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
