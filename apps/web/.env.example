# Public API used by the browser (REST + Socket.IO). Baked in at *build* time.
#
# On Vercel you MUST set this to your real backend HTTPS origin (e.g. https://api.myapp.run).
# Do not leave it empty: an empty value makes the app call /auth/* on the static site → 404.
VITE_API_URL=http://localhost:4000

# Optional: Sentry DSN for error reporting
# VITE_SENTRY_DSN=
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
