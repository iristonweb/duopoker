# =============================================================================
# Frontend — локальная разработка (apps/web)
# =============================================================================

# Полный backend (Express + Socket.IO + LiveKit token) на :4000
VITE_API_URL=http://localhost:4000

# ── Vercel production ───────────────────────────────────────────────────────
# VITE_API_URL не задавай — сайт вызывает /auth, /game, /voice на том же домене.
# Секреты (DATABASE_URL, JWT, LIVEKIT) — только в Vercel Dashboard, см. .env.vercel.example

# ── Опционально ─────────────────────────────────────────────────────────────
# VITE_SENTRY_DSN=
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
