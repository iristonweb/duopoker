# =============================================================================
# Vercel serverless API (packages/api) — импорт в Vercel Dashboard
# =============================================================================
# Дубликат .env.vercel.example в корне репо. Заполни значения и Import в Vercel.
# =============================================================================

DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
JWT_SECRET=
JWT_REFRESH_SECRET=
PUBLIC_WEB_URL=https://duopoker.vercel.app
ALLOW_SOLO_QUEUE=true
MOCK_CHECKOUT=true
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud
