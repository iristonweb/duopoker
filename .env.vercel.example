# =============================================================================
# DuoPoker — переменные для Vercel (Production + Preview)
# =============================================================================
# Скопируй в Vercel: Project → Settings → Environment Variables → Import .env
# Или вставь каждую строку вручную. Секреты НЕ коммить в git.
#
# Root Directory на Vercel:
#   • пусто (корень репо) → api/index.ts + vercel.json в корне
#   • apps/web            → apps/web/api/index.ts + apps/web/vercel.json
# VITE_API_URL на Vercel НЕ ЗАДАВАЙ — API на том же домене (/api/*).
# =============================================================================

# ── Обязательно ─────────────────────────────────────────────────────────────

# Neon → Connection string (Pooled, sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Сгенерируй: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Публичный URL сайта (без слэша в конце)
PUBLIC_WEB_URL=https://duopoker.vercel.app

# Один игрок в очереди → бот (удобно для тестов)
ALLOW_SOLO_QUEUE=true

# LiveKit Cloud → Project → Settings → Keys
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud

# ── Рекомендуется (без Stripe) ──────────────────────────────────────────────

MOCK_CHECKOUT=true

# ── Опционально: Stripe ─────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_SILVER=price_...
# STRIPE_PRICE_GOLD=price_...
# STRIPE_PRICE_PLATINUM=price_...
# STRIPE_PRICE_ROYAL=price_...

# ── Опционально: Sentry (Build env, только если нужен) ─────────────────────
# VITE_SENTRY_DSN=
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# ── НЕ добавляй на Vercel ───────────────────────────────────────────────────
# VITE_API_URL=          ← оставь пустым! иначе API уйдёт не туда
# PORT, CORS_ORIGIN, REDIS_URL, MONGO_URL — только для Render / local Express
