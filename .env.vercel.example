# Vercel production environment template (no secrets — copy values into Vercel dashboard)
# Do NOT set VITE_API_URL on Vercel (same-origin /api rewrites).

# Required
DATABASE_URL=
JWT_SECRET=
JWT_REFRESH_SECRET=
PUBLIC_WEB_URL=https://your-app.vercel.app

# Voice (LiveKit)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud

# Demo beta: solo queue spawns a bot when no opponent is found.
# Set false for human-vs-human matchmaking only.
ALLOW_SOLO_QUEUE=true
MOCK_CHECKOUT=true

# Production launch — set before accepting real payments
# MOCK_CHECKOUT=false
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_SILVER=
# STRIPE_PRICE_GOLD=
# STRIPE_PRICE_PLATINUM=
# STRIPE_PRICE_ROYAL=

# Email verification (optional)
# REQUIRE_EMAIL_VERIFICATION=true
# RESEND_API_KEY=
# EMAIL_FROM=DuoPoker <noreply@yourdomain.com>
