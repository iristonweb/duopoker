# =============================================================================
# DuoPoker — Vercel Environment Variables (template, no secrets)
# =============================================================================
# Import into Vercel Dashboard → Settings → Environment Variables
# Apply to Production + Preview. Do NOT commit real secrets to git.
#
# Build-time (Vite):
#   - Do NOT set VITE_API_URL on Vercel (leave unset). Same-origin /api/* is used.
#
# Runtime (serverless API):
# =============================================================================

# --- Required ---

# Neon PostgreSQL pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.neon.tech/neondb?sslmode=require

# Random secrets (64+ chars each). Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# 64 hex chars — AES-256-GCM for profile fields at rest (required in production)
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=

# Internal notify bridge (required in production)
NOTIFY_INTERNAL_SECRET=

# Your deployed frontend URL (no trailing slash)
PUBLIC_WEB_URL=https://duopoker.ru

# Comma-separated extra origins (optional)
CORS_ORIGIN=https://duopoker.ru,https://www.duopoker.ru,https://duopoker.vercel.app

# --- Recommended ---

ALLOW_SOLO_QUEUE=true
MOCK_CHECKOUT=true

# --- Optional: email verification ---
# REQUIRE_EMAIL_VERIFICATION=false
# RESEND_API_KEY=
# EMAIL_FROM=DuoPoker <onboarding@resend.dev>

# --- Optional: LiveKit voice (Mode A) ---
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_URL=wss://xxx.livekit.cloud

# --- Optional: Stripe player subscriptions ---
# Create prices: pnpm stripe:setup:env (requires STRIPE_SECRET_KEY in apps/backend/.env)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_BRONZE=
# STRIPE_PRICE_SILVER=
# STRIPE_PRICE_GOLD=
# STRIPE_PRICE_PLATINUM=
# STRIPE_PRICE_DIAMOND=
# STRIPE_PRICE_BLACK=

# --- Optional: YooKassa club plans ---
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=

# --- Optional: seed superadmin locally (`pnpm --filter @duopoker/db-schema seed`) ---
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# --- Do NOT set on Vercel (Mode A) ---
# VITE_API_URL=

# --- Mode B only: external Render/Fly backend with Socket.IO ---
# Set VITE_API_URL at build time to your external API host, e.g.:
# VITE_API_URL=https://duopoker-api.onrender.com

# --- Push notifications (Web Push — required for duopoker.ru Vercel-only) ---
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your@email.com

# --- Optional Mode B only (Render/Fly + Socket.IO) — skip if Vercel-only ---
# BACKEND_INTERNAL_URL=https://your-api.example.com
# NOTIFY_INTERNAL_SECRET=
# VITE_API_URL=https://your-api.example.com
