{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @duopoker/db-schema build && pnpm --filter @duopoker/game-engine build && pnpm --filter @duopoker/shared-types build && node scripts/bundle-vercel-api.mjs && pnpm --filter @duopoker/web build",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "packages/db-schema/src/generated/**"
    }
  },
  "rewrites": [
    { "source": "/auth/:path*", "destination": "/api" },
    { "source": "/profile/:path*", "destination": "/api" },
    { "source": "/game/:path*", "destination": "/api" },
    { "source": "/monetization/:path*", "destination": "/api" },
    { "source": "/clubs/:path*", "destination": "/api" },
    { "source": "/voice/:path*", "destination": "/api" },
    { "source": "/health", "destination": "/api/health" },
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
