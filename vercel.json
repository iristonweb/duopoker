{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @duopoker/db-schema build && pnpm --filter @duopoker/shared-types build && pnpm --filter @duopoker/game-engine build && node scripts/bundle-vercel-api.mjs && pnpm --filter @duopoker/web build",
  "outputDirectory": "apps/web/dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), payment=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-site" }
      ]
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "packages/db-schema/src/generated/**"
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!api/|assets/|icons/|robots\\.txt|sitemap\\.xml|favicon\\.png|apple-touch-icon\\.png|manifest\\.webmanifest|sw\\.js|workbox-).*)", "destination": "/index.html" }
  ]
}
