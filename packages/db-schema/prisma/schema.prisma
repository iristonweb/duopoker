generator client {
  provider   = "prisma-client-js"
  output     = "../src/generated/prisma-client"
  /** WASM avoids Windows EPERM locks on query_engine-windows.dll.node */
  engineType = "wasm"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Tier {
  SILVER
  GOLD
  PLATINUM
  ROYAL
}

enum Status {
  ACTIVE
  EXPIRED
  CANCELLED
  LOBBY
  IN_PROGRESS
  FINISHED
}

enum Mode {
  HOLDEM
  RASPISNOY
}

enum Rarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum PaymentProvider {
  STRIPE
  APPLE_IAP
  GOOGLE_PLAY
  YOOKASSA
}

enum PrivateTableSeatStatus {
  INVITED
  ACCEPTED
  SEATED
  DECLINED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum ClubRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum ClubVisibility {
  PRIVATE
  INVITE_ONLY
}

enum PrivateTableStatus {
  SCHEDULED
  LIVE
  CLOSED
}

enum OrganizerPlanTier {
  BASIC
  PRO
  NETWORK
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String?
  displayName   String
  nickname      String         @unique
  avatar        String?
  emailVerified Boolean        @default(true)
  verificationToken String?
  verificationTokenExpiresAt DateTime?
  chips         Int            @default(10000)
  level         Int            @default(1)
  xp            Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
  inventory     UserItem[]
  devices       DeviceSession[]
  payments      PaymentEvent[]
  clubsOwned    Club[]         @relation("club_owner")
  clubMemberships ClubMembership[]
  tableSeats    PrivateTableSeat[]
  tableInvitesSent PrivateTableSeat[] @relation("seat_inviter")
  @@map("users")
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  tier      Tier
  status    Status
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  @@map("subscriptions")
}

model UserItem {
  id       String  @id @default(cuid())
  userId   String
  itemId   String
  rarity   Rarity
  equipped Boolean @default(false)
  user     User    @relation(fields: [userId], references: [id])
  @@map("user_inventory")
}

model GameSession {
  id         String   @id @default(cuid())
  mode       Mode
  status     Status
  players    String[]
  buyIn      Int
  rake       Int
  startedAt  DateTime?
  finishedAt DateTime?
  hands      Hand[]
  replayMeta ReplayMeta?
  /** Serialized SessionState snapshot for reconnect / multi-instance recovery */
  gameState  Json?
  @@map("game_sessions")
}

model MatchmakingTicket {
  userId    String   @id
  mode      Mode
  buyIn     Int
  createdAt DateTime @default(now())
  @@map("matchmaking_tickets")
}

model MatchAssignment {
  userId    String   @id
  sessionId String
  mode      Mode
  buyIn     Int
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@map("match_assignments")
}

model Hand {
  id        String      @id @default(cuid())
  sessionId String
  round     Int
  cards     String[]
  actions   Json
  winnerId  String?
  pot       Int
  session   GameSession @relation(fields: [sessionId], references: [id])
  @@map("hands")
}

model DeviceSession {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  deviceId     String
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  user         User     @relation(fields: [userId], references: [id])
  @@map("device_sessions")
}

model PaymentEvent {
  id               String          @id @default(cuid())
  userId           String
  provider         PaymentProvider
  providerEventId  String          @unique
  status           PaymentStatus
  amount           Int
  currency         String          @default("USD")
  metadata         Json?
  createdAt        DateTime        @default(now())
  user             User            @relation(fields: [userId], references: [id])
  @@map("payment_events")
}

model ReplayMeta {
  id          String      @id @default(cuid())
  sessionId   String      @unique
  eventCount  Int         @default(0)
  startedAt   DateTime?
  finishedAt  DateTime?
  session     GameSession @relation(fields: [sessionId], references: [id])
  @@map("replay_meta")
}

model Club {
  id               String                 @id @default(cuid())
  ownerId          String
  name             String
  description      String?
  visibility       ClubVisibility         @default(PRIVATE)
  isArchived       Boolean                @default(false)
  maxMembers       Int                    @default(30)
  maxActiveTables  Int                    @default(2)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  owner            User                   @relation("club_owner", fields: [ownerId], references: [id])
  members          ClubMembership[]
  privateTables    PrivateTable[]
  organizerPlan    OrganizerSubscription?
  complianceEvents ComplianceEvent[]
  @@index([ownerId])
  @@map("clubs")
}

model ClubMembership {
  id        String   @id @default(cuid())
  clubId     String
  userId     String
  role       ClubRole @default(MEMBER)
  joinedAt   DateTime @default(now())
  club       Club     @relation(fields: [clubId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
  @@unique([clubId, userId])
  @@index([userId])
  @@map("club_memberships")
}

model PrivateTable {
  id              String             @id @default(cuid())
  clubId           String
  hostUserId       String
  name             String
  mode             Mode
  status           PrivateTableStatus @default(SCHEDULED)
  maxPlayers       Int                @default(9)
  virtualBuyIn     Int                @default(1000)
  sessionId        String?            @unique
  inviteCode       String             @unique @default(cuid())
  createdAt        DateTime           @default(now())
  startsAt         DateTime?
  closedAt         DateTime?
  club             Club               @relation(fields: [clubId], references: [id])
  seats            PrivateTableSeat[]
  @@index([clubId, status])
  @@index([inviteCode])
  @@map("private_tables")
}

model PrivateTableSeat {
  id              String                 @id @default(cuid())
  tableId         String
  userId          String
  status          PrivateTableSeatStatus @default(INVITED)
  invitedByUserId String?
  invitedAt       DateTime               @default(now())
  table           PrivateTable           @relation(fields: [tableId], references: [id], onDelete: Cascade)
  user            User                   @relation(fields: [userId], references: [id])
  invitedBy       User?                  @relation("seat_inviter", fields: [invitedByUserId], references: [id])
  @@unique([tableId, userId])
  @@index([userId])
  @@map("private_table_seats")
}

model OrganizerSubscription {
  id                    String            @id @default(cuid())
  clubId                 String            @unique
  ownerId                String
  tier                   OrganizerPlanTier
  status                 Status
  startsAt               DateTime          @default(now())
  expiresAt              DateTime
  billingProvider        PaymentProvider
  providerSubscriptionId String?
  providerPaymentId      String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  club                   Club              @relation(fields: [clubId], references: [id])
  @@index([ownerId])
  @@map("organizer_subscriptions")
}

model ComplianceEvent {
  id          String   @id @default(cuid())
  clubId       String
  actorUserId  String?
  type         String
  severity     String   @default("INFO")
  details      Json?
  createdAt    DateTime @default(now())
  club         Club     @relation(fields: [clubId], references: [id])
  @@index([clubId, createdAt])
  @@map("compliance_events")
}
