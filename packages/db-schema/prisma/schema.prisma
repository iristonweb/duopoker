generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma-client"
  /**
   * WASM avoids Windows EPERM locks on query_engine-windows.dll.node
   */
  engineType      = "wasm"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum Tier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
  BLACK
}

enum Status {
  ACTIVE
  EXPIRED
  CANCELLED
  LOBBY
  IN_PROGRESS
  FINISHED
}

enum Mode {
  HOLDEM
  JOKER
}

enum Rarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum PaymentProvider {
  STRIPE
  APPLE_IAP
  GOOGLE_PLAY
  YOOKASSA
}

enum PrivateTableSeatStatus {
  INVITED
  ACCEPTED
  SEATED
  DECLINED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum ClubRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum ClubVisibility {
  PRIVATE
  INVITE_ONLY
}

enum PrivateTableStatus {
  SCHEDULED
  LIVE
  CLOSED
}

enum OrganizerPlanTier {
  BASIC
  PRO
  NETWORK
}

enum OrganizerBillingStatus {
  TRIAL
  ACTIVE
  GRACE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum UserRole {
  USER
  SUPERADMIN
}

enum PlatformDuelStatus {
  PENDING
  LIVE
  CANCELLED
  EXPIRED
}

enum PlatformDuelInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ReferralStatus {
  PENDING
  ACTIVE
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String?
  displayName   String
  nickname      String         @unique
  avatar        String?
  tableStatus   String?
  role          UserRole       @default(USER)
  emailVerified Boolean        @default(true)
  verificationToken String?
  verificationTokenExpiresAt DateTime?
  chips         Int            @default(10000)
  level         Int            @default(1)
  xp            Int            @default(0)
  gamesPlayed   Int            @default(0)
  gamesWon      Int            @default(0)
  gamesLost     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
  inventory     UserItem[]
  devices       DeviceSession[]
  payments      PaymentEvent[]
  clubsOwned    Club[]         @relation("club_owner")
  clubMemberships ClubMembership[]
  tableSeats    PrivateTableSeat[]
  tableInvitesSent PrivateTableSeat[] @relation("seat_inviter")
  duelsHosted   PlatformDuel[]     @relation("duel_host")
  duelInvites   PlatformDuelInvite[]
  referralCode  ReferralCode?
  referralsMade Referral[]         @relation("referrals_made")
  referredBy    Referral?          @relation("referred_user")
  referralRewards ReferralRewardClaim[]
  pushSubscriptions PushSubscription[]
  deviceTokens      DeviceToken[]
  deletionRequests  AccountDeletionRequest[]
  @@map("users")
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  tier      Tier
  status    Status
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  @@map("subscriptions")
}

model UserItem {
  id       String  @id @default(cuid())
  userId   String
  itemId   String
  rarity   Rarity
  equipped Boolean @default(false)
  user     User    @relation(fields: [userId], references: [id])
  @@map("user_inventory")
}

model GameSession {
  id         String   @id @default(cuid())
  mode       Mode
  status     Status
  players    String[]
  buyIn      Int
  rake       Int
  startedAt  DateTime?
  finishedAt DateTime?
  hands      Hand[]
  replayMeta ReplayMeta?
  /** Serialized SessionState snapshot for reconnect / multi-instance recovery */
  gameState  Json?
  chatMessages TableChatMessage[]
  @@map("game_sessions")
}

model TableChatMessage {
  id          String   @id @default(cuid())
  sessionId   String
  userId      String
  displayName String
  avatar      String?
  text        String
  createdAt   DateTime @default(now())
  session     GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("table_chat_messages")
}

model MatchmakingTicket {
  userId    String   @id
  mode      Mode
  buyIn     Int
  createdAt DateTime @default(now())
  @@map("matchmaking_tickets")
}

model MatchAssignment {
  userId    String   @id
  sessionId String
  mode      Mode
  buyIn     Int
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@map("match_assignments")
}

model Hand {
  id        String      @id @default(cuid())
  sessionId String
  round     Int
  cards     String[]
  actions   Json
  winnerId  String?
  pot       Int
  session   GameSession @relation(fields: [sessionId], references: [id])
  @@map("hands")
}

model DeviceSession {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  deviceId     String
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  user         User     @relation(fields: [userId], references: [id])
  @@map("device_sessions")
}

model PaymentEvent {
  id               String          @id @default(cuid())
  userId           String
  provider         PaymentProvider
  providerEventId  String          @unique
  status           PaymentStatus
  amount           Int
  currency         String          @default("USD")
  metadata         Json?
  createdAt        DateTime        @default(now())
  user             User            @relation(fields: [userId], references: [id])
  @@map("payment_events")
}

model ReplayMeta {
  id          String      @id @default(cuid())
  sessionId   String      @unique
  eventCount  Int         @default(0)
  startedAt   DateTime?
  finishedAt  DateTime?
  session     GameSession @relation(fields: [sessionId], references: [id])
  @@map("replay_meta")
}

model Club {
  id               String                 @id @default(cuid())
  ownerId          String
  name             String
  description      String?
  visibility       ClubVisibility         @default(PRIVATE)
  isArchived       Boolean                @default(false)
  maxMembers       Int                    @default(30)
  maxActiveTables  Int                    @default(2)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  owner            User                   @relation("club_owner", fields: [ownerId], references: [id])
  members          ClubMembership[]
  privateTables    PrivateTable[]
  organizerPlan    OrganizerSubscription?
  complianceEvents ComplianceEvent[]
  usageSnapshots   ClubUsageSnapshot[]
  @@index([ownerId])
  @@map("clubs")
}

model ClubMembership {
  id        String   @id @default(cuid())
  clubId     String
  userId     String
  role       ClubRole @default(MEMBER)
  joinedAt   DateTime @default(now())
  club       Club     @relation(fields: [clubId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
  @@unique([clubId, userId])
  @@index([userId])
  @@map("club_memberships")
}

model PrivateTable {
  id              String             @id @default(cuid())
  clubId           String
  hostUserId       String
  name             String
  mode             Mode
  status           PrivateTableStatus @default(SCHEDULED)
  maxPlayers       Int                @default(9)
  virtualBuyIn     Int                @default(1000)
  sessionId        String?            @unique
  inviteCode       String             @unique @default(cuid())
  createdAt        DateTime           @default(now())
  startsAt         DateTime?
  closedAt         DateTime?
  club             Club               @relation(fields: [clubId], references: [id])
  seats            PrivateTableSeat[]
  @@index([clubId, status])
  @@index([inviteCode])
  @@map("private_tables")
}

model PrivateTableSeat {
  id              String                 @id @default(cuid())
  tableId         String
  userId          String
  status          PrivateTableSeatStatus @default(INVITED)
  invitedByUserId String?
  invitedAt       DateTime               @default(now())
  table           PrivateTable           @relation(fields: [tableId], references: [id], onDelete: Cascade)
  user            User                   @relation(fields: [userId], references: [id])
  invitedBy       User?                  @relation("seat_inviter", fields: [invitedByUserId], references: [id])
  @@unique([tableId, userId])
  @@index([userId])
  @@map("private_table_seats")
}

model OrganizerSubscription {
  id                    String                 @id @default(cuid())
  clubId                 String                 @unique
  ownerId                String
  tier                   OrganizerPlanTier
  status                 Status
  billingStatus          OrganizerBillingStatus @default(ACTIVE)
  startsAt               DateTime               @default(now())
  expiresAt              DateTime
  billingProvider        PaymentProvider
  providerSubscriptionId String?
  providerPaymentId      String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  club                   Club                   @relation(fields: [clubId], references: [id])
  @@index([ownerId])
  @@index([billingStatus])
  @@map("organizer_subscriptions")
}

model ComplianceEvent {
  id          String   @id @default(cuid())
  clubId       String?
  actorUserId  String?
  type         String
  severity     String   @default("INFO")
  details      Json?
  resolvedAt   DateTime?
  createdAt    DateTime @default(now())
  club         Club?    @relation(fields: [clubId], references: [id])
  @@index([clubId, createdAt])
  @@index([severity, createdAt])
  @@map("compliance_events")
}

model AccountDeletionRequest {
  id        String   @id @default(cuid())
  userId    String
  reason    String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, status])
  @@map("account_deletion_requests")
}

model ClubUsageSnapshot {
  id                String   @id @default(cuid())
  clubId            String
  memberCount       Int
  activeTableCount  Int
  billingCycleStart DateTime
  capturedAt        DateTime @default(now())
  club              Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  @@index([clubId, billingCycleStart])
  @@map("club_usage_snapshots")
}

model IdempotencyKey {
  id        String   @id @default(cuid())
  key       String   @unique
  userId    String
  path      String
  response  Json?
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/** Admin-initiated VIP table — invited players accept before the host starts the session. */
model PlatformDuel {
  id        String             @id @default(cuid())
  hostId    String
  message   String?
  mode      Mode
  buyIn     Int
  sessionId String?            @unique
  status    PlatformDuelStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime           @default(now())
  startedAt DateTime?
  host      User               @relation("duel_host", fields: [hostId], references: [id])
  invites   PlatformDuelInvite[]
  @@index([hostId, status])
  @@map("platform_duels")
}

model ReferralCode {
  id        String   @id @default(cuid())
  userId    String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("referral_codes")
}

model Referral {
  id           String         @id @default(cuid())
  referrerId   String
  referredId   String         @unique
  code         String
  status       ReferralStatus @default(PENDING)
  handsPlayed  Int            @default(0)
  registeredAt DateTime       @default(now())
  activatedAt  DateTime?
  referrer     User           @relation("referrals_made", fields: [referrerId], references: [id])
  referred     User           @relation("referred_user", fields: [referredId], references: [id])
  @@index([referrerId, status])
  @@map("referrals")
}

model ReferralRewardClaim {
  id        String   @id @default(cuid())
  userId    String
  level     Int
  chips     Int      @default(0)
  claimedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, level])
  @@map("referral_reward_claims")
}

model PlatformDuelInvite {
  id          String                   @id @default(cuid())
  duelId      String
  userId      String
  status      PlatformDuelInviteStatus @default(PENDING)
  respondedAt DateTime?
  duel        PlatformDuel             @relation(fields: [duelId], references: [id], onDelete: Cascade)
  user        User                     @relation(fields: [userId], references: [id])
  @@unique([duelId, userId])
  @@index([userId, status])
  @@map("platform_duel_invites")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("push_subscriptions")
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("device_tokens")
}
