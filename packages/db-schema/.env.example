# =============================================================================
# Prisma — только для pnpm db:push / db:migrate локально
# =============================================================================
# Скопируй в packages/db-schema/.env (тот же DATABASE_URL что на Vercel/Neon)
# =============================================================================

DATABASE_URL=postgresql://duopoker:duopoker@127.0.0.1:5434/duopoker
# Same as DATABASE_URL for local Postgres; on Neon use the non-pooler (direct) connection string.
DIRECT_DATABASE_URL=postgresql://duopoker:duopoker@127.0.0.1:5434/duopoker

# If `pnpm db:migrate` fails with P3005 (DB created via db:push), run once from repo root:
#   pnpm db:baseline
#   pnpm db:migrate

# Optional: create platform superadmin on `pnpm seed` (never commit real passwords)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=your-secure-password-here
