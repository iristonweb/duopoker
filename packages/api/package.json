{
  "name": "@duopoker/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/app.ts",
  "exports": {
    ".": "./src/app.ts",
    "./app": "./src/app.ts",
    "./lib/*": "./src/lib/*",
    "./services/*": "./src/services/*"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/dev-server.ts",
    "lint": "eslint src",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@duopoker/db-schema": "workspace:*",
    "@duopoker/server-shared": "workspace:*",
    "@duopoker/game-engine": "workspace:*",
    "@duopoker/server-core": "workspace:*",
    "@duopoker/session-core": "workspace:*",
    "@duopoker/shared-types": "workspace:*",
    "@hono/node-server": "^1.14.1",
    "@upstash/redis": "^1.34.9",
    "bcryptjs": "^3.0.3",
    "google-auth-library": "^10.6.2",
    "hono": "^4.12.25",
    "jsonwebtoken": "^9.0.2",
    "livekit-server-sdk": "^2.15.4",
    "stripe": "^22.0.2",
    "web-push": "^3.6.7",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.3"
  }
}
