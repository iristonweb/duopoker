{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@duopoker/shared-types/*": ["../shared-types/dist/*"],
      "@duopoker/shared-types/index": ["../shared-types/dist/index"],
