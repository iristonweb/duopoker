# packages/api local dev — copy to packages/api/.env
PORT=3001

DATABASE_URL=postgresql://duopoker:duopoker@127.0.0.1:5434/duopoker

JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-refresh

# Required in production (64 hex chars):
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=
NOTIFY_INTERNAL_SECRET=

PUBLIC_WEB_URL=http://localhost:5180
CORS_ORIGIN=http://localhost:5180,http://127.0.0.1:5180

ALLOW_SOLO_QUEUE=true
MOCK_CHECKOUT=true

# Push notifications
# Generate: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:your@email.com
BACKEND_INTERNAL_URL=http://localhost:4000
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# FOUNDER_GRANT_SECRET=
# OAuth (mobile / web)
# GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_ENABLED=true
# APPLE_CLIENT_ID=app.duopoker.mobile
# OAUTH_APPLE_ENABLED=true

# RevenueCat (mobile IAP webhooks)
# REVENUECAT_WEBHOOK_SECRET=

# AI coach (optional — dev uses rule-based fallback)
# COACH_LLM_API_KEY=
# COACH_MODEL=gpt-4o-mini
